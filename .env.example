# Copy to .env.local and fill in. All are optional — the site runs without them.

# Public site URL — used for canonical tags, sitemap, OG images, structured data.
NEXT_PUBLIC_SITE_URL=https://waverstudio.com

# Optional booking link (Cal.com / Calendly). When set, "Book a call" CTAs appear.
NEXT_PUBLIC_BOOKING_URL=

# Contact form delivery (Resend — https://resend.com).
# Without RESEND_API_KEY the form still works but only logs the lead server-side.
RESEND_API_KEY=
# Where leads are delivered (defaults to the studio email if unset).
LEAD_TO_EMAIL=waverstudio@gmail.com
# Verified sender. Until you verify a domain in Resend, keep the onboarding sender.
LEAD_FROM_EMAIL=WaverStudio <onboarding@resend.dev>
